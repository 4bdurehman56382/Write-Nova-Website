# Brevo setup for the project inquiry form. Never use a PUBLIC_ prefix here.
BREVO_API_KEY=xkeysib_your_brevo_api_key
# This address must be verified in Brevo before it can send email.
BREVO_FROM_EMAIL=your-verified-sender@example.com
BREVO_FROM_NAME=WriteNova
CONTACT_TO_EMAIL=hello@writenova.com

# Public contact links used in the header/footer. Use digits only for WhatsApp.
PUBLIC_WHATSAPP_NUMBER=15551234567
PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/your-company

# Optional measurement and verification for the production site.
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
PUBLIC_GOOGLE_SITE_VERIFICATION=your-search-console-verification-token
