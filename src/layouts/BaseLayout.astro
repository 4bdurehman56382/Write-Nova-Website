---
import '../styles/global.css';
import faviconUrl from '../../Assets/writenova-mark.svg';
import socialImageUrl from '../../Assets/writenova-mark@1200.png';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'WriteNova — Content That Connects. Copy That Converts.',
  description = 'High-quality content writing for businesses and agencies: SEO blogs, website copy, landing pages, email content, and white-label writing support.',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const socialImageAbsoluteUrl = new URL(socialImageUrl.src, Astro.site ?? Astro.url.origin).href;
const searchConsoleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const analyticsId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const linkedInUrl = import.meta.env.PUBLIC_LINKEDIN_URL;
const whatsAppNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'WriteNova',
  description,
  url: canonicalUrl,
  image: socialImageAbsoluteUrl,
  ...(whatsAppNumber ? { telephone: `+${whatsAppNumber}` } : {}),
  ...(linkedInUrl ? { sameAs: [linkedInUrl] } : {}),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#161316" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageAbsoluteUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageAbsoluteUrl} />
    {searchConsoleVerification && <meta name="google-site-verification" content={searchConsoleVerification} />}
    <link rel="icon" type="image/svg+xml" href={faviconUrl.src} />
    <link rel="apple-touch-icon" href={socialImageUrl.src} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600,700&display=swap" />
    {analyticsId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}></script>
        <script is:inline define:vars={{ analyticsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { window.dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', analyticsId);
        </script>
      </>
    )}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
