---
import BaseLayout from '../layouts/BaseLayout.astro';
import logoUrl from '../../Assets/writenova-mark.svg';

const whatsAppNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER?.replace(/\D/g, '');
const whatsAppUrl = whatsAppNumber ? `https://wa.me/${whatsAppNumber}` : '#contact';
const linkedInUrl = import.meta.env.PUBLIC_LINKEDIN_URL || '#contact';

const services = [
  {
    title: 'SEO Blog Writing',
    copy: 'Engaging, search-friendly blog content tailored to your audience, brand voice, and business goals.',
    tag: 'Search with substance',
  },
  {
    title: 'Website Copy',
    copy: 'Clear, persuasive website content that communicates your value and builds trust.',
    tag: 'Words that clarify',
  },
  {
    title: 'Landing Page Copy',
    copy: 'Conversion-focused copy designed to communicate benefits clearly and encourage action.',
    tag: 'Built to move',
  },
  {
    title: 'Email Copy',
    copy: 'Professional content for marketing campaigns, newsletters, promotions, and customer communication.',
    tag: 'Keep the conversation moving',
  },
  {
    title: 'White-Label Content Writing',
    copy: 'Behind-the-scenes content support for agencies that need additional writing capacity under their own brand.',
    tag: 'Quietly dependable',
  },
  {
    title: 'B2B & SaaS Content',
    copy: 'Research-driven content that explains complex products and services clearly.',
    tag: 'Complex, made clear',
  },
  {
    title: 'Medical & Research-Based Writing',
    copy: 'Well-structured, research-focused articles and educational content for suitable medical and research topics.',
    tag: 'Carefully researched',
  },
  {
    title: 'PR & Press Release Writing',
    copy: 'Professional press releases and PR-focused content. Media placement, where available, is quoted separately.',
    tag: 'A message worth noticing',
  },
];

const reasons = [
  'Human-written, audience-focused content',
  'SEO-friendly structure and readability',
  'Content tailored to your brand voice',
  'Reliable turnaround and clear communication',
  'One-off or ongoing content support',
  'White-label support for agencies',
  'Trusted network of specialist writers for projects requiring additional expertise',
];

const process = [
  ['Tell Us What You Need', 'Share your project, goals, audience, style, and deadline.'],
  ['Understand Your Brand', 'We review your brief, brand voice, references, and objectives.'],
  ['Writing & Research', 'The assigned writer researches and creates content according to the brief.'],
  ['Review & Refinement', 'Content is quality-checked and revised within the agreed scope.'],
  ['Delivery', 'Final content is delivered in the agreed format and timeline.'],
];

const industries = [
  'Marketing & Advertising',
  'SaaS & Technology',
  'E-commerce',
  'Professional Services',
  'Healthcare & Medical',
  'Real Estate',
  'Education',
  'Hospitality & Lifestyle',
  'Startups & Growing Businesses',
];

const faqs = [
  ['Do you work with agencies?', 'Yes. We provide white-label content support for agencies that need reliable additional writing capacity.'],
  ['Can you match our brand voice?', 'Yes. Content is tailored to the brand guidelines, tone, audience, and objectives in the brief.'],
  ['Do you offer ongoing content support?', 'Yes. We can support recurring blogs, website updates, campaigns, and other ongoing content.'],
  ['Can I request revisions?', 'Yes. Revisions are handled according to the agreed project scope.'],
  ['How do you price projects?', 'Pricing depends on content type, word count, research, complexity, and turnaround. A custom quote is provided after reviewing the brief.'],
  ['Do you provide PR/media placement?', 'We provide PR and press release writing. Media placement, where available, is quoted separately.'],
];
---

<BaseLayout>
  <header class="site-header" data-header>
    <div class="shell header-inner">
      <a class="brand" href="#top" aria-label="WriteNova home">
        <img src={logoUrl.src} alt="" width="32" height="32" />
        <span>Write<span>Nova</span></span>
      </a>
      <nav id="site-nav" class="site-nav" aria-label="Primary navigation" data-menu>
        <a href="#top">Home</a>
        <a href="#services">Services</a>
        <a href="#why-writenova">Why WriteNova</a>
        <a href="#how-we-work">How We Work</a>
        <a href="#about">About</a>
        <a href="#industries">Industries</a>
        <a href="#faqs">FAQs</a>
        <a class="nav-cta" href="#contact">Contact <span aria-hidden="true">↗</span></a>
      </nav>
      <div class="header-tools">
        <div class="header-socials" aria-label="Social links">
          <a href={whatsAppUrl} target={whatsAppNumber ? '_blank' : undefined} rel={whatsAppNumber ? 'noreferrer' : undefined} aria-label="Contact WriteNova on WhatsApp" title={whatsAppNumber ? 'Chat with WriteNova on WhatsApp' : 'Business WhatsApp number to be connected'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 3.5A11.8 11.8 0 0 0 12.05 0C5.48 0 .14 5.33.14 11.9c0 2.09.54 4.12 1.57 5.92L0 24l6.35-1.66a11.88 11.88 0 0 0 5.7 1.45h.01c6.56 0 11.9-5.33 11.9-11.9 0-3.18-1.24-6.16-3.46-8.4ZM12.05 21.8a9.9 9.9 0 0 1-5.05-1.39l-.36-.21-3.77.99 1-3.68-.24-.38a9.9 9.9 0 1 1 8.42 4.67Zm5.43-7.42c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.66.15-.2.3-.76.97-.93 1.17-.17.2-.35.22-.65.07-1.77-.88-2.94-1.57-4.11-3.56-.31-.53.31-.5.88-1.66.1-.2.05-.37-.02-.52-.08-.15-.66-1.59-.9-2.18-.24-.57-.49-.5-.66-.5h-.57c-.2 0-.52.08-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.47 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.5 1.89.82 2.63.9 3.58.76.58-.09 1.76-.72 2.01-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z"/></svg></a>
          <a href={linkedInUrl} target={import.meta.env.PUBLIC_LINKEDIN_URL ? '_blank' : undefined} rel={import.meta.env.PUBLIC_LINKEDIN_URL ? 'noreferrer' : undefined} aria-label="Find WriteNova on LinkedIn" title={import.meta.env.PUBLIC_LINKEDIN_URL ? 'Visit WriteNova on LinkedIn' : 'LinkedIn profile to be connected'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.58c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.67H9.34V8.98h3.41v1.57h.05c.47-.9 1.64-1.85 3.37-1.85 3.61 0 4.28 2.38 4.28 5.47v6.28ZM5.32 7.41a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14Zm-1.78 13.04h3.57V8.98H3.54v11.47Z"/></svg></a>
        </div>
        <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-button>
          <span class="sr-only">Open navigation</span>
          <span></span><span></span>
        </button>
      </div>
    </div>
  </header>

  <main id="main-content">
    <section id="top" class="hero" aria-labelledby="hero-title">
      <div class="hero-aura" aria-hidden="true"></div>
      <div class="shell hero-grid">
        <div class="hero-copy">
          <p class="hero-kicker hero-intro">For businesses and agencies that want to be understood.</p>
          <h1 id="hero-title">
            <span class="hero-line">Content that</span>
            <span class="hero-line accent-line">connects.</span>
            <span class="hero-line">Copy that converts.</span>
          </h1>
          <p class="hero-description hero-intro">High-quality content writing for businesses and agencies — from SEO blogs and website copy to landing pages, email content, and white-label content support.</p>
          <div class="hero-actions hero-intro">
            <a class="button button-primary" href="#contact">Let’s Talk About Your Project <span aria-hidden="true">↗</span></a>
            <a class="button button-quiet" href="#services">View Our Services <span aria-hidden="true">↓</span></a>
          </div>
        </div>

        <div class="hero-composition" aria-label="A visual composition representing content strategy and brand voice" data-hero-composition>
          <div class="composition-glow"></div>
          <div class="story-sheet sheet-back"><span>STRATEGY</span><span>VOICE</span><span>SEARCH</span></div>
          <div class="story-sheet sheet-mid"><span>01 / THE BRIEF</span><b>Make it<br />matter.</b><i></i><i></i><i></i></div>
          <div class="story-sheet sheet-front">
            <span>WRITENOVA / COPY SYSTEM</span>
            <strong>Words with<br /><em>direction.</em></strong>
            <div class="sheet-footer"><img src={logoUrl.src} alt="" width="22" height="22" /><span>Human-led writing</span></div>
          </div>
          <div class="composition-badge"><span class="badge-dot"></span><span>Clear intent<br />in every line</span></div>
          <div class="composition-note"><b>Brand first.</b><span>Format follows.</span></div>
        </div>
      </div>
      <div class="shell hero-baseline" aria-hidden="true"><span>SEO</span><span>WEB</span><span>CAMPAIGNS</span><span>WHITE-LABEL</span><span>RESEARCH</span></div>
    </section>

    <section id="services" class="section services-section" aria-labelledby="services-title">
      <div class="shell">
        <div class="section-heading section-heading-split services-heading reveal-group">
          <div class="services-intro">
            <p class="section-label">The work</p>
            <p>Eight focused services for the pages, campaigns, and research-led projects that make a business easier to understand.</p>
          </div>
          <div>
            <h2 id="services-title">The right words,<br /><span>where they matter.</span></h2>
            <p>One writing partner for the pages, messages, and long-form content that shape how people understand your business.</p>
          </div>
        </div>
        <div class="service-layout reveal-group">
          <div class="service-grid" aria-label="WriteNova services">
            {services.map((service, index) => (
              <article class="service-card" style={`--index:${index}`}>
                <span class="service-number">0{index + 1}</span>
                <p>{service.tag}</p>
                <h3>{service.title}</h3>
                <div class="service-card-bottom"><span>{service.copy}</span><a href="#contact" aria-label={`Ask about ${service.title}`}>↗</a></div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="why-writenova" class="section reason-section" aria-labelledby="reason-title">
      <div class="reason-atmosphere" aria-hidden="true"></div>
      <div class="shell reason-layout">
        <div class="reason-copy reveal-group">
          <p class="section-label">Why WriteNova</p>
          <h2 id="reason-title">A clear voice is<br /><span>good business.</span></h2>
          <p>Strong content is more than polished wording. It listens to the audience, holds the brand together, and makes the next step feel natural.</p>
          <a class="text-link" href="#about">Meet the thinking behind WriteNova <span aria-hidden="true">↗</span></a>
        </div>
        <ol class="reason-list reveal-group">
          {reasons.map((reason, index) => <li><span>0{index + 1}</span><p>{reason}</p></li>)}
        </ol>
      </div>
    </section>

    <section id="how-we-work" class="section process-section" aria-labelledby="process-title">
      <div class="shell">
        <div class="section-heading process-heading reveal-group">
          <p class="section-label">How we work</p>
          <div class="process-title"><h2 id="process-title">Less back-and-forth.<br /><span>More forward motion.</span></h2></div>
          <p class="process-summary">Five clear steps keep the brief, the writing, and the delivery moving in the same direction.</p>
        </div>
        <ol class="process-list reveal-group">
          {process.map(([title, copy], index) => (
            <li class="process-item">
              <span class="process-number">{String(index + 1).padStart(2, '0')}</span>
              <h3>{title}</h3>
              <p>{copy}</p>
              <span class="process-arrow" aria-hidden="true">↘</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="industries" class="section industries-section" aria-labelledby="industries-title">
      <div class="shell">
        <div class="section-heading industry-heading reveal-group">
          <p class="section-label">Industries we serve</p>
          <h2 id="industries-title">Different fields.<br /><span>One clear signal.</span></h2>
          <p>The project changes. The need for clarity does not. We adapt the research, tone, structure, and level of detail to the work in front of us.</p>
        </div>
        <div class="industry-field reveal-group">
          {industries.map((industry, index) => (
            <div class="industry-row"><span>{String(index + 1).padStart(2, '0')}</span><b>{industry}</b></div>
          ))}
        </div>
      </div>
    </section>

    <section id="about" class="section about-section" aria-labelledby="about-title">
      <div class="shell about-layout reveal-group">
        <div class="about-mark" aria-hidden="true"><img src={logoUrl.src} alt="" width="160" height="160" /></div>
        <div class="about-copy">
          <p class="section-label">About WriteNova</p>
          <h2 id="about-title">Writing that knows<br />what it’s here to do.</h2>
          <p>WriteNova is a content writing agency helping businesses and agencies communicate with clarity and purpose. We provide SEO content, website copy, landing pages, email copy, research-based writing, and white-label content support.</p>
          <p>Our approach combines strong writing, research, brand understanding, and dependable project delivery.</p>
          <a class="button button-outline" href="#contact">Start a conversation <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section id="faqs" class="section faq-section" aria-labelledby="faq-title">
      <div class="shell faq-layout">
        <div class="faq-intro reveal-group">
          <p class="section-label">FAQs</p>
          <h2 id="faq-title">Good questions.<br /><span>Clear answers.</span></h2>
          <p>If yours isn’t here, send us the brief. We’ll point you in the right direction.</p>
        </div>
        <div class="faq-list reveal-group">
          {faqs.map(([question, answer], index) => (
            <details class="faq-item" open={index === 0}>
              <summary>{question}<span aria-hidden="true"></span></summary>
              <div><p>{answer}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="contact-section" aria-labelledby="contact-title">
      <div class="contact-aura" aria-hidden="true"></div>
      <div class="shell contact-layout">
        <div class="contact-copy reveal-group">
          <p class="section-label">Start here</p>
          <h2 id="contact-title">Let’s talk about<br /><span>your project.</span></h2>
          <p>Have a project in mind? Tell us a little about what you need, and our team will get back to you.</p>
          <div class="contact-side-note"><img src={logoUrl.src} alt="" width="28" height="28" /><span>Details make<br />better work.</span></div>
        </div>
        <form class="inquiry-form reveal-group" action="/api/contact" method="POST" data-inquiry-form>
          <div class="form-grid">
            <label class="field"><span>Full Name <b>*</b></span><input name="fullName" autocomplete="name" required /></label>
            <label class="field"><span>Business / Company Name</span><input name="company" autocomplete="organization" /></label>
            <label class="field"><span>Email Address <b>*</b></span><input name="email" type="email" autocomplete="email" required /></label>
            <label class="field"><span>WhatsApp / Phone Number <b>*</b></span><input name="phone" type="tel" autocomplete="tel" required /></label>
            <label class="field"><span>Country <b>*</b></span><input name="country" autocomplete="country-name" required /></label>
            <label class="field"><span>Service Required <b>*</b></span>
              <select name="service" required>
                <option value="">Choose a service</option>
                {services.map((service) => <option value={service.title}>{service.title}</option>)}
              </select>
            </label>
            <label class="field field-wide"><span>Project Details <b>*</b></span><textarea name="details" rows="5" required placeholder="Goals, audience, scope, preferred style — anything useful."></textarea></label>
            <label class="field"><span>Estimated Budget <small>Optional</small></span><input name="budget" /></label>
            <label class="field"><span>Expected Deadline <small>Optional</small></span><input name="deadline" type="date" /></label>
          </div>
          <div class="form-footer">
            <p class="form-status" aria-live="polite" data-form-status></p>
            <button class="button button-primary submit-button" type="submit" data-submit-button><span>Submit Project Inquiry</span><i aria-hidden="true"></i><b aria-hidden="true">↗</b></button>
          </div>
        </form>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-lede">
      <div class="footer-brand">
        <a class="brand" href="#top" aria-label="WriteNova home"><img src={logoUrl.src} alt="" width="32" height="32" /><span>Write<span>Nova</span></span></a>
        <p>Content that connects.<br />Copy that converts.</p>
      </div>
      <a class="footer-project" href="#contact"><span>Start a project</span><strong>Let’s make it<br />clear. <i aria-hidden="true">↗</i></strong></a>
    </div>
    <div class="shell footer-directory">
      <div class="footer-links">
        <nav aria-label="Footer navigation">
          <a href="#services">Services</a>
          <a href="#why-writenova">Why WriteNova</a>
          <a href="#how-we-work">How We Work</a>
          <a href="#industries">Industries</a>
          <a href="#about">About</a>
          <a href="#faqs">FAQs</a>
        </nav>
      </div>
      <div class="footer-socials" aria-label="Social links">
        <a href={whatsAppUrl} target={whatsAppNumber ? '_blank' : undefined} rel={whatsAppNumber ? 'noreferrer' : undefined} aria-label="Contact WriteNova on WhatsApp" title={whatsAppNumber ? 'Chat with WriteNova on WhatsApp' : 'Business WhatsApp number to be connected'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 3.5A11.8 11.8 0 0 0 12.05 0C5.48 0 .14 5.33.14 11.9c0 2.09.54 4.12 1.57 5.92L0 24l6.35-1.66a11.88 11.88 0 0 0 5.7 1.45h.01c6.56 0 11.9-5.33 11.9-11.9 0-3.18-1.24-6.16-3.46-8.4ZM12.05 21.8a9.9 9.9 0 0 1-5.05-1.39l-.36-.21-3.77.99 1-3.68-.24-.38a9.9 9.9 0 1 1 8.42 4.67Zm5.43-7.42c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.66.15-.2.3-.76.97-.93 1.17-.17.2-.35.22-.65.07-1.77-.88-2.94-1.57-4.11-3.56-.31-.53.31-.5.88-1.66.1-.2.05-.37-.02-.52-.08-.15-.66-1.59-.9-2.18-.24-.57-.49-.5-.66-.5h-.57c-.2 0-.52.08-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.47 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.5 1.89.82 2.63.9 3.58.76.58-.09 1.76-.72 2.01-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z"/></svg></a>
        <a href={linkedInUrl} target={import.meta.env.PUBLIC_LINKEDIN_URL ? '_blank' : undefined} rel={import.meta.env.PUBLIC_LINKEDIN_URL ? 'noreferrer' : undefined} aria-label="Find WriteNova on LinkedIn" title={import.meta.env.PUBLIC_LINKEDIN_URL ? 'Visit WriteNova on LinkedIn' : 'LinkedIn profile to be connected'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.58c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.67H9.34V8.98h3.41v1.57h.05c.47-.9 1.64-1.85 3.37-1.85 3.61 0 4.28 2.38 4.28 5.47v6.28ZM5.32 7.41a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14Zm-1.78 13.04h3.57V8.98H3.54v11.47Z"/></svg></a>
      </div>
    </div>
    <div class="shell footer-bottom"><span>© {new Date().getFullYear()} WriteNova. All rights reserved.</span><a href="#contact">Privacy policy available on request</a></div>
  </footer>

  <script>
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const menuButton = document.querySelector('[data-menu-button]');
    const menu = document.querySelector('[data-menu]');

    menuButton?.addEventListener('click', () => {
      const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!isOpen));
      menu?.classList.toggle('is-open', !isOpen);
      document.body.classList.toggle('menu-open', !isOpen);
    });

    menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
      menuButton?.setAttribute('aria-expanded', 'false');
      menu?.classList.remove('is-open');
      document.body.classList.remove('menu-open');
    }));

    if (!prefersReducedMotion && 'IntersectionObserver' in window) {
      document.documentElement.classList.add('has-reveal-motion');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.14 });
      document.querySelectorAll('.reveal-group').forEach((group) => observer.observe(group));
    }

    const composition = document.querySelector<HTMLElement>('[data-hero-composition]');
    if (composition && !prefersReducedMotion && window.matchMedia('(pointer: fine)').matches) {
      composition.addEventListener('pointermove', (event) => {
        const bounds = composition.getBoundingClientRect();
        const x = (event.clientX - bounds.left) / bounds.width - 0.5;
        const y = (event.clientY - bounds.top) / bounds.height - 0.5;
        composition.style.setProperty('--pointer-x', x.toFixed(3));
        composition.style.setProperty('--pointer-y', y.toFixed(3));
      });
      composition.addEventListener('pointerleave', () => {
        composition.style.setProperty('--pointer-x', '0');
        composition.style.setProperty('--pointer-y', '0');
      });
    }

    const form = document.querySelector<HTMLFormElement>('[data-inquiry-form]');
    const status = document.querySelector<HTMLElement>('[data-form-status]');
    const submitButton = document.querySelector<HTMLButtonElement>('[data-submit-button]');

    if (form && status && submitButton) {
      const requiredInputs = form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('[required]');

      function validateField(field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) {
        const value = field.value.trim();
        let message = '';
        if (!value) message = 'This field is required.';
        else if (field instanceof HTMLInputElement && field.type === 'email' && !/^\S+@\S+\.\S+$/.test(value)) message = 'Enter a valid email address.';
        field.setAttribute('aria-invalid', String(Boolean(message)));
        const fieldWrapper = field.closest('.field');
        fieldWrapper?.classList.toggle('has-error', Boolean(message));
        let error = fieldWrapper?.querySelector<HTMLElement>('.field-error');
        if (message && !error) {
          error = document.createElement('span');
          error.className = 'field-error';
          error.setAttribute('role', 'alert');
          fieldWrapper?.append(error);
        }
        if (error) error.textContent = message;
        return !message;
      }

      requiredInputs.forEach((field) => field.addEventListener('blur', () => validateField(field)));

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const isValid = [...requiredInputs].every((field) => validateField(field));
        if (!isValid) {
          status.textContent = 'Please review the highlighted fields.';
          status.className = 'form-status is-error';
          form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
          return;
        }

        submitButton.disabled = true;
        submitButton.classList.add('is-loading');
        status.textContent = 'Sending your project details…';
        status.className = 'form-status';

        try {
          const payload = Object.fromEntries(new FormData(form).entries());
          const response = await fetch(form.action, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(payload),
          });
          const result = await response.json().catch(() => null) as { ok?: boolean; message?: string } | null;

          if (!response.ok || !result?.ok) throw new Error(result?.message || 'Request failed');

          form.reset();
          status.textContent = result.message || 'Thank you for contacting WriteNova. We’ve received your project details and will get back to you shortly.';
          status.className = 'form-status is-success';
        } catch (error) {
          status.textContent = error instanceof Error && error.message ? error.message : 'We could not send your inquiry. Please try again in a moment.';
          status.className = 'form-status is-error';
        } finally {
          submitButton.disabled = false;
          submitButton.classList.remove('is-loading');
        }
      });
    }
  </script>
</BaseLayout>
